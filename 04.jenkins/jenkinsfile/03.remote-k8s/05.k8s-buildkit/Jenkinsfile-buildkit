// git-access.info 기준 테스트 파이프라인.
// - 고정 Agent Pool(label: buildkit git buildah)에서 실행된다.
// - 이미지 빌드는 buildkit(buildctl)을 사용한다.
// - 빌드마다 새 이미지가 되도록 태그 = <VERSION>-<BUILD_NUMBER>-<8자리 랜덤 해시코드>
pipeline {
    agent { label 'buildkit' }

    environment {
        GIT_REPO_URL     = 'https://github.com/himang10/myfirst-api-server.git'
        GIT_REVISION     = 'master'
        GIT_CREDENTIALS  = 'skala-git-credentials'

        IMAGE_NAME       = 'webserver'
        VERSION          = '1.0'
        DOCKER_REGISTRY  = 'skala-registry.skala-ai.com'
        DOCKER_PROJECT   = 'class-0'
        REGISTRY_CREDENTIALS = 'skala-image-registry'
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${GIT_REVISION}",
                    url: "${GIT_REPO_URL}",
                    credentialsId: "${GIT_CREDENTIALS}"
            }
        }

        stage('Build (Maven)') {
            steps {
                // Dockerfile이 target/*.jar를 그대로 COPY하는 구조이므로 이미지 빌드 전에
                // 애플리케이션을 미리 패키징해 둔다.
                sh 'mvn -B -q clean package -DskipTests'
            }
        }

        stage('Prepare Tag') {
            steps {
                script {
                    // build-count(BUILD_NUMBER) + 8자리 랜덤 해시코드를 붙여 매 빌드마다 새 이미지가 되도록 함
                    def randomHash = sh(script: 'openssl rand -hex 4', returnStdout: true).trim()
                    env.IMAGE_TAG = "${VERSION}-${env.BUILD_NUMBER}-${randomHash}"
                    env.IMAGE_FULL = "${DOCKER_REGISTRY}/${DOCKER_PROJECT}/${IMAGE_NAME}:${env.IMAGE_TAG}"
                    echo "빌드 이미지: ${env.IMAGE_FULL}"
                }
            }
        }

        stage('Build & Push (buildkit)') {
            steps {
                withCredentials([usernamePassword(
                        credentialsId: "${REGISTRY_CREDENTIALS}",
                        usernameVariable: 'REG_USER',
                        passwordVariable: 'REG_PASS')]) {
                    sh '''
                        set -euo pipefail

                        DOCKER_CONFIG_DIR="$(pwd)/.docker-config"
                        mkdir -p "${DOCKER_CONFIG_DIR}"
                        AUTH=$(printf '%s:%s' "${REG_USER}" "${REG_PASS}" | base64 -w0)
                        cat > "${DOCKER_CONFIG_DIR}/config.json" <<EOF
{"auths":{"${DOCKER_REGISTRY}":{"auth":"${AUTH}"}}}
EOF
                        export DOCKER_CONFIG="${DOCKER_CONFIG_DIR}"

                        buildctl --addr unix:///run/buildkit/buildkitd.sock build \
                            --frontend dockerfile.v0 \
                            --local context=. \
                            --local dockerfile=. \
                            --output type=image,name="${IMAGE_FULL}",push=true

                        rm -rf "${DOCKER_CONFIG_DIR}"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Push 완료: ${env.IMAGE_FULL}"
        }
        always {
            cleanWs()
        }
    }
}
